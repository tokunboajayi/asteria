# Copy to web/.env.local (git-ignored), then rebuild (npm run build).
# Optional. Sent to the browser by design: give the token only the assets:read scope
# and allow only http://localhost:3000 in your Cesium ion account.
NEXT_PUBLIC_CESIUM_ION_TOKEN=
# Where the engine API runs (default shown).
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
