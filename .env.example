# ─────────────────────────────────────────────────────────────────────────────
#  Asteria settings — the one place for every key and setting.
#
#  1. Copy this file to .env.local in this same folder:
#       PowerShell:  Copy-Item .env.example .env.local
#  2. Fill in what you need. Everything is optional: Asteria runs without any of it.
#  3. Restart the engine; rebuild the console (cd web; npm run build) for NEXT_PUBLIC_ values.
#
#  .env.local is git-ignored. Never commit it, never paste its contents in chat.
#  A value set in the system environment overrides the same name here.
# ─────────────────────────────────────────────────────────────────────────────

# ── Storm Ghost (orbits) ──────────────────────────────────────────────────────
# Free account: https://www.space-track.org/auth/createAccount
# Used only to log in to Space-Track; never logged or written anywhere else.
# Then run:  cd engine; uv run asteria build-orbits
SPACETRACK_USER=
SPACETRACK_PASSWORD=

# ── 3D globe: real terrain and Cesium imagery ────────────────────────────────
# https://ion.cesium.com/tokens  — create a token with ONLY the assets:read scope,
# and under "Allowed URLs" allow only http://localhost:3000.
# This token is sent to the browser by design (that is what NEXT_PUBLIC_ means).
NEXT_PUBLIC_CESIUM_ION_TOKEN=

# ── Where the console finds the engine API ───────────────────────────────────
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# ── Advanced (leave empty unless you know you need them) ─────────────────────
# Web addresses allowed to call the engine API, comma-separated.
ASTERIA_WEB_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Folder for downloaded sources, caches and built artifacts (default: .asteria here).
ASTERIA_HOME=
